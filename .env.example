# Copy to .env for `pnpm dev`. Values match docker-compose.yml (pnpm infra:up).
# Production needs only these too; everything else is set in Admin settings.
DATABASE_URL=postgres://opensign:opensign@localhost:5480/opensign
S3_ENDPOINT=http://localhost:9310
S3_BUCKET=opensign
S3_ACCESS_KEY=opensign
S3_SECRET_KEY=opensign-secret
S3_REGION=us-east-1
APP_SECRET=dev-only-secret-do-not-use-in-production-0123456789
APP_URL=http://localhost:5173
# Word and other office formats are converted by Gotenberg on a private network.
CONVERTER_URL=http://localhost:3320

# Optional, in .env.local (gitignored): the seed copies these into Admin settings.
# SEED_RESEND_API_KEY=
# SEED_AI_PROVIDER=anthropic
# SEED_AI_MODEL=claude-sonnet-5-5
# SEED_AI_API_KEY=
