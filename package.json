{
  "name": "opensign",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.7.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"cargo run --bin opensign\" \"pnpm --filter @opensign/web dev\"",
    "build": "pnpm --filter @opensign/web build && cargo build --release --bin opensign",
    "typecheck": "pnpm --filter @opensign/web typecheck",
    "lint": "biome check . && cargo clippy --workspace --all-targets -- -D warnings",
    "lint:fix": "biome check --write . && cargo fmt --all",
    "test": "cargo test --workspace && pnpm --filter @opensign/web test",
    "test:e2e": "pnpm --filter @opensign/web exec playwright test",
    "api:types": "pnpm --filter @opensign/web api:types",
    "infra:up": "docker compose up -d --wait postgres s3 mailpit webhooks converter && docker compose run --rm s3-init",
    "infra:down": "docker compose down",
    "stack:up": "docker compose --profile prod up -d --build --wait",
    "stack:fresh": "docker compose --profile prod down -v && docker compose --profile prod up -d --build --wait"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22",
    "concurrently": "^9.2.1",
    "typescript": "^6"
  }
}
